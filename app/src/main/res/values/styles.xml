<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.SpendTrack.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SpendTrack.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SpendTrack.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.SpendTrack.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="Widget.SpendTrack.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="cardCornerRadius">@dimen/corner_lg</item>
        <item name="cardElevation">@dimen/elevation_sm</item>
    </style>

    <style name="Widget.SpendTrack.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.SpendTrack.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_container_high</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.SpendTrack.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_container_low</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="CalcButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/surface_container_lowest</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">1dp</item>
    </style>
    <style name="CalcButton.Operator">
        <item name="backgroundTint">@color/secondary_container</item>
        <item name="android:textColor">@color/on_secondary_container</item>
    </style>

    <style name="CalcButton.Danger">
        <item name="backgroundTint">@color/error_container</item>
        <item name="android:textColor">@color/on_error_container</item>
    </style>

    <style name="CalcButton.Equals">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>
</resources>